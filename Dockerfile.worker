FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /worker

COPY requirements-worker.txt /tmp/requirements-worker.txt
RUN pip install --no-cache-dir -r /tmp/requirements-worker.txt \
    && useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin booksafe

COPY --chown=root:root app/ /worker/app/
RUN chmod -R a=rX /worker/app

USER 10001:10001
ENTRYPOINT ["python", "-m", "app.worker"]
